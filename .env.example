# Copie para .env.local e preencha valores reais (não versionar .env.local).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Auth (painel → Authentication → URL Configuration / Settings):
# - Site URL = mesmo valor que NEXT_PUBLIC_APP_URL
# - Redirect URLs: apenas /auth/callback (e localhost em dev), sem wildcard *
# - JWT expiry: 3600 (1h) para ambientes sensíveis
# - Password strength: ativado

# Só em ambiente servidor (cron, operações privilegiadas). Nunca usar no cliente.
# Nunca prefixar com NEXT_PUBLIC_. A app valida isso no arranque (instrumentation.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Recomendado: segredo para assinar chamadas do cron (evita enviar a service role key).
# Defina também na Edge Function `daily-sync` no Supabase.
CRON_HMAC_SECRET=

# URL pública da aplicação (ex.: https://teu-app.vercel.app ou http://localhost:3000)
# Usada na validação de Origin, CORS da API, report-uri/report-to da CSP e Reporting-Endpoints.
NEXT_PUBLIC_APP_URL=

# HSTS preload (produção): após HTTPS estável em todos os subdomínios, submeter em
# https://hstspreload.org — o header já inclui includeSubDomains; preload.

# Opcional: várias origins válidas para validação CSRF no middleware (separadas por vírgula).
# CSRF_ALLOWED_ORIGINS=https://www.exemplo.com,https://exemplo.com

# Opcional: limite por pedido na sincronização em lote
# SYNC_MAX_COMPANIES=3000

# SRI (CDN externo): npm run sri:hash -- caminho/para/ficheiro.js
# Auditoria de cabeçalhos: https://developer.mozilla.org/en-US/observatory

# P3 pseudonimização SQL: SET app.analytics_salt = 'segredo-rotacionado' antes de relatórios agregados
# ANALYTICS_SALT=

# P2/P3: supabase/scripts/incident_response_checklist.txt

# ─── Cloudflare R2 — Armazenamento de anexos de alvarás ───
# Obter no painel do Cloudflare > R2 > Manage R2 API Tokens.
# Nunca prefixar com NEXT_PUBLIC_. Estes segredos são exclusivos do servidor.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=notifique-anexos
# Domínio público do bucket (Custom Domain ou subdomínio r2.dev).
# Em produção, considerar bucket privado com Signed URLs temporárias.
R2_PUBLIC_CUSTOM_DOMAIN=
